{
	"schemaVersion": 1,
	"id": "luahud",
	"version": "${version}",
	"name": "LuaHUD",
	"description": "Creates highly flexible and fully customizable HUDs using Lua scripting",
	"authors": [
		"iFair"
	],
	"contact": {
		"homepage": "https://modrinth.com/mod/luahud",
		"sources": "https://github.com/iFair1/luahud"
	},
	"license": "LGPLv3",
	"icon": "assets/luahud/icon.png",
	"environment": "client",
	"entrypoints": {
		"client": [
			"dev.ifair.luahud.LuaHUD"
		],
		"modmenu": [
			"dev.ifair.luahud.ModMenuIntegration"
		]
	},
	"accessWidener": "luahud.accesswidener",
	"mixins": [
		"luahud.mixins.json"
	],
	"depends": {
		"fabricloader": ">=${loader_version}",
		"minecraft": "${minecraft_range}",
		"java": ">=${java_version}",
		"fabric-api": "*"
	}
}
